{
  "format": "squid-target-v1",
  "id": "xteink-x4",
  "name": "XTEINK X4",
  "status": "reference",
  "sourceAttribution": [
    {
      "name": "Papyrix X4 Specifications",
      "url": "https://github.com/bigbag/papyrix-reader/blob/main/docs/x4-specifications.md",
      "scope": "Display panel/controller, display pins, SD pins, battery monitoring, USB detection, and pin summary."
    },
    {
      "name": "Papyrix source constants",
      "url": "https://github.com/bigbag/papyrix-reader/blob/main/src/main.cpp",
      "scope": "Display and SD SPI pin constants used by the firmware."
    },
    {
      "name": "Papyrix InputManager",
      "url": "https://github.com/bigbag/papyrix-reader/blob/main/lib/InputManager/src/InputManager.cpp",
      "scope": "ADC ladder ranges and button mapping."
    },
    {
      "name": "Papyrix SDCardManager",
      "url": "https://github.com/bigbag/papyrix-reader/blob/main/lib/SDCardManager/src/SDCardManager.cpp",
      "scope": "microSD chip-select pin and SD initialization frequency."
    },
    {
      "name": "CrossPoint storage and web upload code",
      "url": "https://github.com/crosspoint-reader/crosspoint-reader",
      "scope": "Reference behavior for XTEINK-family SD initialization, web upload staging, incomplete upload cleanup, and AP/STA IP reporting."
    },
    {
      "name": "Adafruit XTEINK X4 CircuitPython Pinouts",
      "url": "https://learn.adafruit.com/circuitpython-on-the-xteink-x4-ereader/pinouts",
      "scope": "Independent confirmation of display, SD, button, and battery wiring."
    }
  ],
  "mcu": {
    "part": "ESP32-C3",
    "family": "ESP32C3",
    "cpu": {
      "cores": 1,
      "frequencyMHz": 160
    },
    "memory": {
      "internalSramKB": 400,
      "psramKB": 0
    },
    "flash": {
      "sizeMB": 16
    }
  },
  "firmwareUpdate": {
    "formats": ["esp-idf-bin"],
    "preferredFormat": "esp-idf-bin",
    "userReplacement": "serial-or-web-flash",
    "uf2": {
      "status": "deferred",
      "reason": "UF2 support is desired for SquidScript firmware replacement, but the verified XTEINK X4 bootloader/update path has not yet been confirmed as UF2-capable."
    }
  },
  "firmware": {
    "zephyr": {
      "board": "esp32c3_devkitm",
      "buildDir": "build/zephyr/xteink-x4",
      "overlay": "firmware/zephyr/boards/xteink_x4.overlay",
      "fallbackSource": "firmware/zephyr/fallback/xteink-x4-main.squid",
      "targetKconfig": "target/zephyr/generated/xteink-x4-target.conf",
      "runtimeLimits": "targets/runtime-limits/esp32c3-zephyr.json"
    },
    "native": {
      "package": "squidscript-fw-x4",
      "workingDir": "firmware/native",
      "target": "riscv32imc-unknown-none-elf",
      "chip": "esp32c3",
      "elf": "target/riscv32imc-unknown-none-elf/debug/squidscript-fw-x4",
      "otaImage": "target/riscv32imc-unknown-none-elf/debug/squidscript-fw-x4-ota.bin",
      "partitionTable": "targets/partitions/xteink-x4.csv",
      "features": [
        "firmware-bin",
        "x4-binbook",
        "x4-flash-filesystem",
        "native-radio-services",
        "wifi",
        "ble"
      ],
      "release": false,
      "rustupToolchain": "nightly",
      "bleConnectionWatchdogMs": 30000
    }
  },
  "radios": {
    "wifi": {
      "type": "wifi",
      "band": "2.4GHz",
      "standard": "802.11b/g/n",
      "status": "runtime-supported-reference",
      "runtimeFeatures": [
        "service.wifi.status",
        "service.wifi.scan",
        "service.wifi.startAP",
        "service.wifi.stopAP",
        "service.wifi.getAPIP",
        "service.wifi.connect",
        "service.wifi.disconnect"
      ],
      "reason": "XTEINK X4 uses an ESP32-C3 radio. SquidScript runtime support follows the ESP32-C3 Zephyr reference path; X4 hardware validation remains target bring-up work."
    },
    "ble": {
      "type": "bluetooth-le",
      "standard": "Bluetooth LE",
      "status": "runtime-supported-reference",
      "runtimeFeatures": ["service.ble.file-transfer"],
      "reason": "XTEINK X4 uses the ESP32-C3 Bluetooth LE radio class. File-transfer validation on this board is separate from enabling the Zephyr build target."
    }
  },
  "pins": {
    "GPIO0": {
      "capabilities": ["gpio", "adc"],
      "voltage": "3v3",
      "usedBy": ["battery.voltage"]
    },
    "GPIO1": {
      "capabilities": ["gpio", "adc"],
      "voltage": "3v3",
      "usedBy": ["input.buttons_adc_1"]
    },
    "GPIO2": {
      "capabilities": ["gpio", "adc"],
      "voltage": "3v3",
      "usedBy": ["input.buttons_adc_2"]
    },
    "GPIO3": {
      "capabilities": ["gpio", "wake"],
      "voltage": "3v3",
      "usedBy": ["input.power_button"]
    },
    "GPIO4": {
      "capabilities": ["gpio"],
      "voltage": "3v3",
      "usedBy": ["display.dc"]
    },
    "GPIO5": {
      "capabilities": ["gpio"],
      "voltage": "3v3",
      "usedBy": ["display.rst"]
    },
    "GPIO6": {
      "capabilities": ["gpio"],
      "voltage": "3v3",
      "usedBy": ["display.busy"]
    },
    "GPIO7": {
      "capabilities": ["gpio", "spi_miso"],
      "voltage": "3v3",
      "usedBy": ["storage.sd.miso"]
    },
    "GPIO8": {
      "capabilities": ["gpio", "spi_sck"],
      "voltage": "3v3",
      "usedBy": ["bus.spi.shared.sck"]
    },
    "GPIO10": {
      "capabilities": ["gpio", "spi_mosi"],
      "voltage": "3v3",
      "usedBy": ["bus.spi.shared.mosi"]
    },
    "GPIO12": {
      "capabilities": ["gpio"],
      "voltage": "3v3",
      "usedBy": ["storage.sd.cs"]
    },
    "GPIO20": {
      "capabilities": ["gpio", "uart_rx"],
      "voltage": "3v3",
      "usedBy": ["power.usb_detect"]
    },
    "GPIO21": {
      "capabilities": ["gpio"],
      "voltage": "3v3",
      "usedBy": ["display.cs"]
    }
  },
  "buses": {
    "spi": {
      "shared": {
        "sck": "GPIO8",
        "mosi": "GPIO10",
        "miso": "GPIO7",
        "mode": 0,
        "bitOrder": "msb-first",
        "maxFrequencyHz": 40000000,
        "devices": ["display.epd", "storage.sd"]
      }
    }
  },
  "devices": {
    "display.epd": {
      "type": "epaper-display",
      "controller": "SSD1677",
      "panel": "GDEQ0426T82",
      "bus": "spi.shared",
      "pins": {
        "cs": "GPIO21",
        "dc": "GPIO4",
        "rst": "GPIO5",
        "busy": "GPIO6"
      }
    },
    "storage.sd": {
      "type": "spi-sdcard",
      "bus": "spi.shared",
      "mount": "/SD:",
      "pins": {
        "cs": "GPIO12",
        "miso": "GPIO7"
      }
    },
    "battery.voltage": {
      "type": "adc-voltage-divider",
      "adc": "GPIO0",
      "dividerMultiplier": 2.0
    },
    "power.usb_detect": {
      "type": "gpio-usb-detect",
      "gpio": "GPIO20",
      "activeHigh": true
    }
  },
  "display": {
    "device": "display.epd",
    "driver": "ssd1677_xteink_x4",
    "physical": {
      "width": 800,
      "height": 480
    },
    "logical": {
      "width": 480,
      "height": 800,
      "rotation": 270
    },
    "color": {
      "logicalGrayscaleLevels": 16,
      "supportedBpp": [1, 2],
      "defaultBpp": 2,
      "supportedPixelFormats": ["GRAY1_PACKED", "GRAY2_PACKED"],
      "defaultPixelFormat": "GRAY2_PACKED",
      "mapping": "nearest-or-dither",
      "dithering": ["none", "ordered", "error-diffusion"]
    },
    "text": {
      "fontHeights": {
        "supported": [16, 18, 20, 24, 32, 48],
        "default": 20,
        "selection": "nearest"
      }
    },
    "refresh": {
      "full": true,
      "half": true,
      "fast": true,
      "partial": true
    },
    "rendering": {
      "screenPolicies": ["compose", "stream"],
      "defaultPolicy": "compose",
      "policyModeMap": {
        "compose": ["single", "strip"],
        "stream": ["strip", "single"]
      },
      "supportedModes": ["strip", "single"],
      "defaultMode": "strip",
      "stripBufferBytes": 4096,
      "singleBufferBytes1bpp": 48000,
      "singleBufferBytes2bpp": 96000,
      "maxFullBufferBpp": 2
    },
    "quirks": [
      {
        "id": "sunlight-fading-fix",
        "description": "Power down the display after refresh to reduce sunlight fading risk on XTEINK X4 SSD1677 hardware."
      }
    ]
  },
  "storage": {
    "type": "spi-sdcard",
    "device": "storage.sd",
    "mount": "/SD:",
    "filesystem": {
      "required": ["fat32"],
      "optional": ["exfat"]
    },
    "removable": true,
    "cardDetect": null,
    "writeProtect": null,
    "hotSwap": {
      "detect": "io-error-or-remount",
      "requiresUnmountForRemoval": true
    },
    "libraries": [
      {
        "id": "books",
        "volume": "sd",
        "path": "/books",
        "contentTypes": ["binbook"],
        "primary": true
      },
      {
        "id": "apps-inbox",
        "volume": "sd",
        "path": "/inbox/apps",
        "contentTypes": ["sqbc"],
        "primary": true
      },
      {
        "id": "flash-library",
        "volume": "flash",
        "status": "deferred",
        "reason": "Requires an explicit writable flash filesystem partition; it is not implicit unused firmware flash."
      }
    ],
    "supportsApps": true,
    "supportsFile": true,
    "maxFileReadSize": 65536
  },
  "input": {
    "type": "mixed",
    "debounceMs": 5,
    "gestureTiming": {
      "longTapMs": 350,
      "doubleTapWindowMs": 350
    },
    "buttons": [
      {
        "logical": "BACK",
        "type": "adc-ladder-button",
        "adc": "GPIO1",
        "range": {
          "minExclusive": 2200,
          "maxInclusive": 2500
        }
      },
      {
        "logical": "SELECT",
        "type": "adc-ladder-button",
        "adc": "GPIO1",
        "range": {
          "minExclusive": 1600,
          "maxInclusive": 2200
        }
      },
      {
        "logical": "LEFT",
        "type": "adc-ladder-button",
        "adc": "GPIO1",
        "range": {
          "minExclusive": 750,
          "maxInclusive": 1600
        }
      },
      {
        "logical": "RIGHT",
        "type": "adc-ladder-button",
        "adc": "GPIO1",
        "range": {
          "minExclusive": null,
          "maxInclusive": 750
        }
      },
      {
        "logical": "UP",
        "type": "adc-ladder-button",
        "adc": "GPIO2",
        "range": {
          "minExclusive": 750,
          "maxInclusive": 2200
        }
      },
      {
        "logical": "DOWN",
        "type": "adc-ladder-button",
        "adc": "GPIO2",
        "range": {
          "minExclusive": null,
          "maxInclusive": 750
        }
      },
      {
        "logical": "POWER",
        "type": "gpio-button",
        "gpio": "GPIO3",
        "mode": "input_pullup",
        "activeLow": true,
        "wake": true,
        "gestures": ["longTap", "doubleTap"]
      }
    ]
  },
  "power": {
    "type": "battery",
    "battery": {
      "monitor": "battery.voltage",
      "emptyMillivolts": 3000,
      "fullMillivolts": 4200
    },
    "usbDetect": "power.usb_detect",
    "deepSleep": true,
    "wakeKeys": ["POWER"],
    "sleepPolicy": {
      "displaySleep": true,
      "syncStorageBeforeSleep": true,
      "saveAppStateBeforeSleep": true
    }
  },
  "runtime": {
    "squidscript": {
      "version": "0.2",
      "maxBytecodeSize": 32768,
      "maxStateVariables": 64,
      "maxSerializedStateSize": 8192,
      "maxStringLength": 1024,
      "maxFunctionCount": 64,
      "maxFunctionParameters": 8,
      "maxLocalVariablesPerFunction": 32,
      "maxCallDepth": 8,
      "maxInstructionsPerEvent": 2000,
      "maxLoopIterationsPerEvent": 100,
      "maxScreenDrawCommands": 128,
      "maxFileReadSize": 65536,
      "maxListItemsReturned": 256,
      "maxHandles": 16
    }
  },
  "simulator": {
    "layout": "targets/layouts/xteink-x4.layout.json",
    "defaultBackend": "browser-sim"
  },
  "compatibility": [
    "squidscript-0.2",
    "portrait-480x800",
    "pixel-format.GRAY1_PACKED",
    "pixel-format.GRAY2_PACKED"
  ],
  "features": [
    "sdcard",
    "buttons",
    "adc-button-ladder",
    "battery.adc",
    "usb-detect",
    "service.display.draw",
    "display.epaper.ssd1677",
    "service.ble.file-transfer",
    "squidscript.bytecode",
    "state.read",
    "state.write",
    "file.pick",
    "file.read",
    "service.wifi.connect",
    "service.wifi.scan",
    "service.wifi.accessPoint"
  ]
}
