import chrome from "lib/chrome.squid"

requires

state {
  file: string
  navCount: int
  tocIndex: int
  tocTop: int
}

export

screen("t") {
  service.display.clear("white")
  chrome.drawTopBar("TOC")
  if (state.navCount == 0) {
    service.display.text("No TOC", {
      x: 24
      y: 120
      w: 432
      h: 40
      fontHeight: 24
    })
  }
  else {
    service.display.text("C1", {
      x: 24
      y: 64
      w: 360
      h: 32
      fontHeight: 18
    })
    service.display.text("C2", {
      x: 24
      y: 136
      w: 360
      h: 32
      fontHeight: 18
    })
    service.display.text("C3", {
      x: 24
      y: 208
      w: 360
      h: 32
      fontHeight: 18
    })
    service.display.text("C4", {
      x: 24
      y: 280
      w: 360
      h: 32
      fontHeight: 18
    })
    service.display.text("C5", {
      x: 24
      y: 352
      w: 360
      h: 32
      fontHeight: 18
    })
    service.display.text("C6", {
      x: 24
      y: 424
      w: 360
      h: 32
      fontHeight: 18
    })
    service.display.text("C7", {
      x: 24
      y: 496
      w: 360
      h: 32
      fontHeight: 18
    })
    service.display.text("C8", {
      x: 24
      y: 568
      w: 360
      h: 32
      fontHeight: 18
    })
  }
  chrome.drawBottomBar("UP DOWN SELECT BACK")
}
