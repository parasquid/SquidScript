import chrome from "lib/chrome.squid"

requires

state {
  file: string
  title: string
  pageIndex: int
  pageCount: int
  browserIndex: int
}

export

screen("b") {
  service.display.clear("white")
  chrome.drawTopBar("Books")
  if (state.browserIndex == 0) {
    service.display.rect(20, 120, 440, 72, {
      fillColor: "gray4"
    })
  }
  service.display.text("Browse", {
    x: 36
    y: 142
    w: 408
    h: 32
    fontHeight: 24
  })
  if (state.file != "") {
    if (state.browserIndex == 1) {
      service.display.rect(20, 220, 440, 112, {
        fillColor: "gray4"
      })
    }
    service.display.text("Resume", {
      x: 36
      y: 238
      w: 408
      h: 32
      fontHeight: 24
    })
    service.display.text(state.title, {
      x: 36
      y: 278
      w: 320
      h: 28
      fontHeight: 18
    })
    service.display.text("Pg", {
      x: 360
      y: 278
      w: 84
      h: 28
      fontHeight: 18
      align: "right"
    })
  }
  else {
    service.display.text("No book", {
      x: 36
      y: 238
      w: 408
      h: 32
      fontHeight: 18
    })
  }
  chrome.drawBottomBar("UP DOWN SELECT BACK")
}
