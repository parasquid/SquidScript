import chrome from "lib/chrome.squid"

requires

state {
  file: string
  pageIndex: int
  pageCount: int
}

export

screen("r", {
  render: "stream"
}) {
  service.display.clear(color.WHITE)
  service.display.text(state.title, {
    x: 32
    y: 120
    w: 416
    h: 48
    fontHeight: 28
    align: "center"
  })
  service.display.text(state.pageIndex, {
    x: 32
    y: 220
    w: 416
    h: 40
    fontHeight: 24
    align: "center"
  })
  chrome.drawBottomBar("Read")
}
