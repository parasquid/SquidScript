import chrome from "lib/chrome.squid"

requires

state {
  jumpPage: int
  pageCount: int
}

export

screen("j") {
  service.display.clear("white")
  chrome.drawTopBar("Jump")
  service.display.text(state.jumpPage, {
    x: 0
    y: 260
    w: 480
    h: 80
    fontHeight: 48
    align: "center"
  })
  service.display.text(state.pageCount, {
    x: 0
    y: 350
    w: 480
    h: 40
    fontHeight: 24
    align: "center"
  })
  service.display.text("-10 +10", {
    x: 40
    y: 500
    w: 400
    h: 32
    fontHeight: 18
    align: "center"
  })
  service.display.text("-1 +1", {
    x: 40
    y: 540
    w: 400
    h: 32
    fontHeight: 18
    align: "center"
  })
  chrome.drawBottomBar("SELECT BACK")
}
