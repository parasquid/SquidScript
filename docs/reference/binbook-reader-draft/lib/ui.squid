requires

state {
  file: string
  title: string
  pageIndex: int
  pageCount: int
  browserIndex: int
  uiState: string
}

import b from "screens/browser.squid"

import r from "screens/reader.squid"

export

function loadBookInfo() {
  state.title = "Book"
  state.pageCount = 12
  if (state.pageIndex >= state.pageCount) {
    state.pageIndex = state.pageCount - 1
  }
}

export

function saveAndRefresh() {
  state.save()
  screen.refresh()
}

export

function openBrowser() {
  state.uiState = "b"
  screen.open("b.b")
}

export

function browserPrevious() {
  if (state.browserIndex > 0) {
    state.browserIndex = state.browserIndex - 1
    saveAndRefresh()
  }
}

export

function browserNext() {
  if (state.file != "") {
    if (state.browserIndex < 1) {
      state.browserIndex = state.browserIndex + 1
      saveAndRefresh()
    }
  }
}

export

function openSelectedBrowserItem() {
  if (state.browserIndex == 0) {
    browseForBook()
  }
  else {
    resumeBook()
  }
}

export

function browseForBook() {
  let picked = file.pickFile(".bb")
  if (picked != "") {
    state.file = picked
    state.pageIndex = 0
    loadBookInfo()
    state.save()
    openReader()
  }
}

export

function resumeBook() {
  if (state.file != "") {
    loadBookInfo()
    state.save()
    openReader()
  }
}

export

function openReader() {
  state.uiState = "r"
  screen.open("r.r")
}

export

function handleUp() {
  if (state.uiState == "r") {
    previousPage()
  }
  else {
    if (state.uiState == "b") {
      browserPrevious()
    }
  }
}

export

function handleDown() {
  if (state.uiState == "r") {
    nextPage()
  }
  else {
    if (state.uiState == "b") {
      browserNext()
    }
  }
}

export

function handleSelect() {
  if (state.uiState == "b") {
    openSelectedBrowserItem()
  }
}

export

function previousPage() {
  if (state.pageIndex > 0) {
    state.pageIndex = state.pageIndex - 1
    saveAndRefresh()
  }
}

export

function nextPage() {
  if (state.pageIndex < state.pageCount - 1) {
    state.pageIndex = state.pageIndex + 1
    saveAndRefresh()
  }
}
