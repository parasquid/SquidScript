app "binbook-reader" target "xteink-x4"

import ui from "lib/ui.squid"

state {
  stateVersion: int = 1,
  file: string = "",
  title: string = "",
  pageIndex: int = 0,
  pageCount: int = 0,
  navCount: int = 0,
  tocIndex: int = 0,
  tocTop: int = 0,
  jumpPage: int = 1,
  browserIndex: int = 0,
  uiState: string = "browser"
}

event.on("app.start") {
  state.load()
  if (state.stateVersion != 1) {
    state.reset()
    state.stateVersion = 1
    state.save()
  }
  ui.openBrowser()
}

event.on("app.exit") {
  state.save()
}

event.on("key.RIGHT") {
  if (state.uiState == "reader") {
    ui.nextPage()
  } else {
    if (state.uiState == "jump") {
      ui.jumpForward10()
    }
  }
}

event.on("key.LEFT") {
  if (state.uiState == "reader") {
    ui.previousPage()
  } else {
    if (state.uiState == "jump") {
      ui.jumpBack10()
    }
  }
}

event.on("key.UP") {
  ui.handleUp()
}

event.on("key.DOWN") {
  ui.handleDown()
}

event.on("key.SELECT") {
  ui.handleSelect()
}

event.on("key.POWER") {
  if (state.uiState == "reader") {
    ui.openToc()
  } else {
    ui.openReader()
  }
}

event.on("key.BACK") {
  if (state.uiState == "reader") {
    ui.openBrowser()
  } else {
    if (state.uiState == "browser") {
      state.save()
      app.exit()
    } else {
      ui.openReader()
    }
  }
}
