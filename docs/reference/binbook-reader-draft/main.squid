app "bb"

import ui from "lib/ui.squid"

state {
  stateVersion: int = 1
  file: string = ""
  title: string = ""
  pageIndex: int = 0
  pageCount: int = 0
  browserIndex: int = 0
  uiState: string = "b"
}

event.on("app.start") {
  state.load()
  if (state.stateVersion != 1) {
    state.reset()
    state.stateVersion = 1
    state.save()
  }
  ui.openBrowser()
}

event.on("app.exit") {
  state.save()
}

event.on("key.RIGHT") {
  if (state.uiState == "r") {
    ui.nextPage()
  }
}

event.on("key.LEFT") {
  if (state.uiState == "r") {
    ui.previousPage()
  }
}

event.on("key.UP") {
  ui.handleUp()
}

event.on("key.DOWN") {
  ui.handleDown()
}

event.on("key.SELECT") {
  ui.handleSelect()
}

event.on("key.POWER") {
  if (state.uiState == "r") {
    ui.openReader()
  }
  else {
    ui.openReader()
  }
}

event.on("key.BACK") {
  if (state.uiState == "r") {
    ui.openBrowser()
  }
  else {
    if (state.uiState == "b") {
      state.save()
      app.exit()
    }
    else {
      ui.openReader()
    }
  }
}
