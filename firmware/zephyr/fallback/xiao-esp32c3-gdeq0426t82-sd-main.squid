app "main"

event.on("app.start") {
  service.upload.start({
    id: "sqbc-install"
    accept: [".sqbc"]
    transports: ["ble"]
    events: {
      complete: "upload.complete"
    }
  })
  debug.print("ble installer ready")
  screen.open("main")
}

screen("main") {
  service.display.clear(color.WHITE)
  service.display.text("XIAO ESP32-C3", {
    x: 24
    y: 48
    fontHeight: 24
  })
  service.display.text("ePaper portrait", {
    x: 24
    y: 88
    fontHeight: 20
  })
  service.display.text(system.memory(), {
    x: 24
    y: 136
    fontHeight: 16
  })
  service.display.text(system.storage("apps"), {
    x: 24
    y: 168
    fontHeight: 16
  })
  service.display.text("BLE installer ready", {
    x: 24
    y: 224
    fontHeight: 20
  })
  service.display.text("Push a .sqbc app", {
    x: 24
    y: 264
    fontHeight: 18
  })
}

event.on("upload.complete", ev) {
  let installed = app.install(ev.upload)
  debug.print("installed", ev.transport, installed.id)
  app.launch(installed.id)
}

event.on("app.exit") {
}
