app "main"

event.on("app.start") {
  debug.print("fallback app launched: no foreground app")
  screen.open("main")
}

screen("main") {
  service.display.clear("white")
  service.display.text("SquidScript", { x: 24, y: 32, fontHeight: 24 })
  service.display.text("No foreground app", { x: 24, y: 72, fontHeight: 20 })
}

event.on("app.exit") {
}
