/*
 * SquidScript XIAO ESP32-C3 + Seeed XIAO ePaper Driver Board overlay.
 *
 * The upstream Zephyr xiao_esp32c3 board owns SoC support, USB serial, Wi-Fi,
 * BLE HCI, and the XIAO connector mapping. This overlay describes only the
 * SquidScript target environment layered on that board.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/esp32c3-pinctrl.h>

/ {
	chosen {
		zephyr,console = &usb_serial;
		zephyr,shell-uart = &usb_serial;
	};

	aliases {
		display0 = &squidscript_epaper;
		epaper0 = &squidscript_epaper;
	};

	squidscript_epaper: squidscript_epaper {
		compatible = "squidscript,ssd1677-gdeq0426t82";
		spi = <&spi2>;
		cs-gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;   /* XIAO D1 */
		dc-gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>;  /* XIAO D3 */
		reset-gpios = <&gpio0 2 GPIO_ACTIVE_LOW>; /* XIAO D0, strapping */
		busy-gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>; /* XIAO D2 */
		width = <800>;
		height = <480>;
	};
};

&pinctrl {
	spim2_epaper_default: spim2_epaper_default {
		group1 {
			pinmux = <SPIM2_SCLK_GPIO8>,
				 <SPIM2_MOSI_GPIO10>;
			output-low;
		};
	};
};

&spi2 {
	status = "okay";
	pinctrl-0 = <&spim2_epaper_default>;
	pinctrl-names = "default";
};
