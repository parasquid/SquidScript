menu "SquidScript BLE OTS staging test firmware"

config SQUIDSCRIPT_ZEPHYR_DIAGNOSTIC
	bool "Enable SquidScript diagnostic test paths"
	default y

config SQUIDSCRIPT_BLE_OTS_STAGING_TEST
	bool "Compile the SquidScript BLE OTS staging lifecycle into the test image"
	default y
	help
	  Expose the staging file lifecycle in the native_sim test image so
	  unit tests can verify the obj_created → obj_write → finalize →
	  fs_unlink path with a real host LittleFS mount. The tests
	  install function-pointer stubs for the OTS callbacks; no real
	  Bluetooth is required.

endmenu

source "Kconfig.zephyr"
