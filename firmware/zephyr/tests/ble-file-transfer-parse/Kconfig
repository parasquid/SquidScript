menu "SquidScript BLE GATT parse test firmware"

config SQUIDSCRIPT_ZEPHYR_DIAGNOSTIC
	bool "Enable SquidScript diagnostic test paths"
	default y

config SQUIDSCRIPT_BLE_FILE_TRANSFER_PARSE_TEST
	bool "Compile the SquidScript BLE GATT File name parser into the test image"
	default y
	help
	  Expose the File name parser in the native_sim test image so
	  unit tests can verify validation rules without a real Bluetooth
	  connection. The parser validates the extension-only File name
	  shape used by the custom BLE transfer service.

endmenu

source "Kconfig.zephyr"
