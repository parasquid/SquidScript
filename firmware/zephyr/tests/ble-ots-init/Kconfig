menu "SquidScript BLE OTS init test firmware"

config SQUIDSCRIPT_ZEPHYR_DIAGNOSTIC
	bool "Enable SquidScript diagnostic test paths"
	default y

config SQUIDSCRIPT_BLE_OTS_INIT_TEST
	bool "Compile the SquidScript BLE OTS skeleton into the test image"
	default y
	help
	  Expose the BLE OTS GATT service in the native_sim test image so
	  unit tests can verify that the service is registered and its
	  callbacks are wired without requiring real Bluetooth hardware.
	  The OTS callbacks are stubbed (LOG_DBG + return 0) at this
	  slice; later slices implement the actual staging and dispatch
	  logic.

endmenu

source "Kconfig.zephyr"
