menu "SquidScript BLE OTS parse test firmware"

config SQUIDSCRIPT_ZEPHYR_DIAGNOSTIC
	bool "Enable SquidScript diagnostic test paths"
	default y

config SQUIDSCRIPT_BLE_OTS_PARSE_TEST
	bool "Compile the SquidScript BLE OTS Object Name parser into the test image"
	default y
	help
	  Expose the Object Name parser in the native_sim test image so
	  unit tests can verify validation rules without a real Bluetooth
	  connection. The parser validates the `app_id/profile_id/.ext`
	  Object Name shape used to route an in-flight transfer to the
	  armed SquidScript app.

endmenu

source "Kconfig.zephyr"
