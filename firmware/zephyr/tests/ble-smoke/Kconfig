menu "SquidScript BLE smoke test firmware"

config SQUIDSCRIPT_ZEPHYR_DIAGNOSTIC
	bool "Enable SquidScript diagnostic test paths"
	default y

config SQUIDSCRIPT_BLE_SMOKE_TEST
	bool "Compile the SquidScript BLE smoke state machine into the test image"
	default y
	help
	  Expose the BLE advertising state machine in the native_sim test image
	  without enabling the real Zephyr Bluetooth stack. The unit tests install
	  function-pointer stubs through ble_smoke_sm.h instead of driving
	  bt_le_adv_* directly.

endmenu

source "Kconfig.zephyr"
