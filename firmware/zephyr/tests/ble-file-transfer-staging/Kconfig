menu "SquidScript BLE GATT staging test firmware"

config SQUIDSCRIPT_ZEPHYR_DIAGNOSTIC
	bool "Enable SquidScript diagnostic test paths"
	default y

config SQUIDSCRIPT_BLE_FILE_TRANSFER_STAGING_TEST
	bool "Compile the SquidScript BLE GATT staging lifecycle into the test image"
	default y
	help
	  Expose the staging file lifecycle in the native_sim test image so
	  unit tests can verify the begin → write → finalize →
	  fs_unlink path with a real host LittleFS mount. The tests
	  install function-pointer stubs for the GATT callbacks; no real
	  Bluetooth is required.

endmenu

source "Kconfig.zephyr"
