app "ble-installed-receiver"

event.on("app.start") {
  service.upload.start({
    id: "sqbc-install"
    accept: [".sqbc"]
    transports: ["ble"]
    events: {
      complete: "upload.complete"
    }
  })
  debug.print("ble-installed-receiver ready")
}

event.on("upload.complete", ev) {
  debug.print("ble-installed-receiver complete", ev.transport, ev.id)
  let installed = app.install(ev.upload)
  debug.print("ble-installed-receiver installed", installed.id)
  app.launch(installed.id)
}

screen("main") {}
