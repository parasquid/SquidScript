app "display-primitives"

event.on("app.start") {
  screen.open("main")
}

event.on("key.SELECT") {
  debug.print("selected")
}

screen("main") {
  service.display.clear(color.GRAY0)
  service.display.text("Hello", {
    x: 10
    y: 20
  })
  service.display.rect(1, 2, 3, 4, {
    fillColor: color.GRAY4
  })
  service.display.line(5, 6, 7, 8, {
    color: color.GRAY15
  })
}
