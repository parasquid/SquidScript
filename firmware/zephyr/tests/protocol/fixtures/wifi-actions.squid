app "wifi-actions"

event.on("app.start") {
  let ap = service.wifi.startAP("SquidScript")
  let ip = service.wifi.getAPIP()
  let stop = service.wifi.stopAP()
  let connected = service.wifi.connect("dev")
  let disconnected = service.wifi.disconnect()
  let operation = service.wifi.operation()
  let result = service.wifi.result()
  let network = service.wifi.scanNetwork(0)
  let cancel = service.wifi.cancel()
  debug.print(ap.ok, ap.error)
  debug.print(ip.error)
  debug.print(stop.ok, stop.error, connected.ok, connected.error, disconnected.ok, disconnected.error)
  debug.print(operation.state, result.ok, result.error, network.ok, network.error, cancel.state)
}

screen("main") {
}
