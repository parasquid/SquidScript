app "reader-clock"

state {
  starts: int = 0
  clocks: int = 0
  armedSeen: int = 0
}

event.on("app.start") {
  state.starts = state.starts + 1
  debug.print("reader start", state.starts)
  let process = app.processStack()
  for appId in process max 2 {
    debug.print("reader process", appId)
  }
  service.timer.every("timer.clock", 500)
}

event.on("timer.clock") {
  state.clocks = state.clocks + 1
  if (state.clocks == 1) {
    debug.print("reader clock", state.clocks)
    let armedThisTick = 0
    let armed = app.armedStack()
    for armedApp in armed max 2 {
      armedThisTick = armedThisTick + 1
      debug.print("reader armed", armedApp.appId, armedApp.event)
    }
    if (armedThisTick > 0) {
      let selected = app.armedStack.get(armed, 0)
      debug.print("reader armed selected", selected.appId, selected.event)
      state.armedSeen = armedThisTick
    }
  }
}
