app "break-reminder"

state {
  fires: int = 0
  armedSeen: int = 0
}

app.triggers {
  service.timer.after("timer.break", 3000)
}

event.on("timer.break") {
  state.fires = state.fires + 1
  debug.print("break fired", state.fires)
  let process = app.processStack()
  for
  appId
  in
  process
  max 2 {
    debug.print("break process", appId)
  }
  state.armedSeen = 0
  let armed = app.armedStack()
  for
  armedApp
  in
  armed
  max 2 {
    state.armedSeen = state.armedSeen + 1
    debug.print("break armed", armedApp.appId, armedApp.event)
  }
  if (state.armedSeen == 0) {
    debug.print("break armed empty")
  }
}

event.on("key.SELECT") {
  debug.print("break exit")
  app.exit()
}
