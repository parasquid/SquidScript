app "wifi-station-summary"

state {}

event.on("app.start") {
  let connect = service.wifi.connect("dev")
  debug.print("wifi connect", connect.ok, connect.error)
  service.timer.after("timer.wifi.station", 250)
}

event.on("timer.wifi.station") {
  let operation = service.wifi.operation()
  if operation.done {
    let status = service.wifi.status()
    debug.print("wifi station", status.profile, status.connected, status.state, status.error)
  } else {
    service.timer.after("timer.wifi.station", 250)
  }
}
