app "device-config-summary"

event.on("app.start") {
  let loaded = device.config.load("package:device/indicator.sqdevice")
  let set = device.config.set("mode", "gpio")
  let rebound = device.config.rebind("indicator.default")
  let saved = device.config.save("flash")
  debug.print("device load", loaded.ok, loaded.error, loaded.warning)
  debug.print("device set", set.ok, set.error, set.warning)
  debug.print("device rebind", rebound.ok, rebound.error, rebound.warning)
  debug.print("device save", saved.ok, saved.error, saved.warning)
}
