app "transfer-owner-summary"

state {
  runs: int = 0
}

event.on("app.start") {
  state.load()@runs = @runs + 1
  state.save()
  let loaded = device.config.load("package:device/indicator.sqdevice")
  let scan = service.wifi.scan()
  let operation = service.wifi.operation()
  debug.print("transfer owner", @runs, loaded.ok, loaded.error, scan.ok, scan.error, operation.state)
}
