app "lazy-load-screen-worst-case"

state {
  index: int = 0
}

event.on("app.start") {
  index = 0
  service.timer.every("timer.transition", 1000)
  screen.open("s0")
}

event.on("timer.transition") {
  index = index + 1
  if (index >= 10) {
    index = 0
  }
  if (index == 0) {
    screen.open("s0")
  }
  if (index == 1) {
    screen.open("s1")
  }
  if (index == 2) {
    screen.open("s2")
  }
  if (index == 3) {
    screen.open("s3")
  }
  if (index == 4) {
    screen.open("s4")
  }
  if (index == 5) {
    screen.open("s5")
  }
  if (index == 6) {
    screen.open("s6")
  }
  if (index == 7) {
    screen.open("s7")
  }
  if (index == 8) {
    screen.open("s8")
  }
  if (index == 9) {
    screen.open("s9")
  }
}

screen("s0") {
  service.display.clear("gray0")
  service.display.text("pad", { x: 4, y: 8, color: "gray15" })
