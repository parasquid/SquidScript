app "lazy-load-screen-benchmark"

state {
  index: int = 0
}

event.on("app.start") {
  state.index = 0
  service.timer.every("timer.transition", 1000)
  screen.open("s0")
}

event.on("timer.transition") {
  state.index = state.index + 1
  if (state.index >= 10) {
    state.index = 0
  }
  if (state.index == 0) {
    screen.open("s0")
  }
  if (state.index == 1) {
    screen.open("s1")
  }
  if (state.index == 2) {
    screen.open("s2")
  }
  if (state.index == 3) {
    screen.open("s3")
  }
  if (state.index == 4) {
    screen.open("s4")
  }
  if (state.index == 5) {
    screen.open("s5")
  }
  if (state.index == 6) {
    screen.open("s6")
  }
  if (state.index == 7) {
    screen.open("s7")
  }
  if (state.index == 8) {
    screen.open("s8")
  }
  if (state.index == 9) {
    screen.open("s9")
  }
}

screen("s0") {
  service.display.clear("gray0")
  service.display.text("screen 0", {
    x: 4
    y: 8
    color: "gray15"
  })
}

screen("s1") {
  service.display.clear("gray0")
  service.display.text("screen 1", {
    x: 4
    y: 8
    color: "gray15"
  })
}

