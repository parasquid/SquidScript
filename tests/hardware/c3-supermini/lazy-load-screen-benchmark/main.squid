app "lazy-load-screen-benchmark"

state {
  index: int = 0
}

event.on("app.start") {
  index = 0
  service.timer.every("timer.transition", 1000)
  screen.open("s0")
}

event.on("timer.transition") {
  index = index + 1
  if (index >= 10) {
    index = 0
  }
  if (index == 0) {
    screen.open("s0")
  }
  if (index == 1) {
    screen.open("s1")
  }
  if (index == 2) {
    screen.open("s2")
  }
  if (index == 3) {
    screen.open("s3")
  }
  if (index == 4) {
    screen.open("s4")
  }
  if (index == 5) {
    screen.open("s5")
  }
  if (index == 6) {
    screen.open("s6")
  }
  if (index == 7) {
    screen.open("s7")
  }
  if (index == 8) {
    screen.open("s8")
  }
  if (index == 9) {
    screen.open("s9")
  }
}

screen("s0") {
  service.display.clear("gray0")
  service.display.text("screen 0", { x: 4, y: 8, color: "gray15" })
}

screen("s1") {
  service.display.clear("gray0")
  service.display.text("screen 1", { x: 4, y: 8, color: "gray15" })
}

screen("s2") {
  service.display.clear("gray0")
  service.display.text("screen 2", { x: 4, y: 8, color: "gray15" })
}

screen("s3") {
  service.display.clear("gray0")
  service.display.text("screen 3", { x: 4, y: 8, color: "gray15" })
}

screen("s4") {
  service.display.clear("gray0")
  service.display.text("screen 4", { x: 4, y: 8, color: "gray15" })
}

screen("s5") {
  service.display.clear("gray0")
  service.display.text("screen 5", { x: 4, y: 8, color: "gray15" })
}

screen("s6") {
  service.display.clear("gray0")
  service.display.text("screen 6", { x: 4, y: 8, color: "gray15" })
}

screen("s7") {
  service.display.clear("gray0")
  service.display.text("screen 7", { x: 4, y: 8, color: "gray15" })
}

screen("s8") {
  service.display.clear("gray0")
  service.display.text("screen 8", { x: 4, y: 8, color: "gray15" })
}

screen("s9") {
  service.display.clear("gray0")
  service.display.text("screen 9", { x: 4, y: 8, color: "gray15" })
}
