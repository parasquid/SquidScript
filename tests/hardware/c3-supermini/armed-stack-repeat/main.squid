app "main"

state {
  ticks: int = 0
}

event.on("app.start") {
  app.arm("break-reminder")
  service.timer.every("timer.clock", 300)
}

event.on("timer.clock") {
  state.ticks = state.ticks + 1
  let armed = app.armedStack()
  for armedApp in armed max 2 {
    debug.print("armed", state.ticks, armedApp.appId, armedApp.event)
  }
  let selected = app.armedStack.get(armed, 0)
  debug.print("selected", state.ticks, selected.appId, selected.event)
}
