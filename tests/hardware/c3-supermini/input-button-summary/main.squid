app "input-button-summary"

device {
  input {
    use "gpio-button:GPIO9:key.SELECT:activeLow"
  }
}

state {
  count: int = 0
}

event.on("app.start") {
  state.load()
  debug.print("count", state.count)
}

event.on("key.SELECT") {
  state.load()
  state.count = state.count + 1
  state.save()
  service.indicator.blink(120, 80)
  debug.print("count", state.count)
}
