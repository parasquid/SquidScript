app "radio-both-summary"

event.on("app.start") {
  let ap = service.wifi.startAP("SquidScript")
  service.upload.start({
    id: "rx"
    accept: [".sqbc"]
    transports: ["ble"]
    events: {
      complete: "upload.complete"
    }
  })
  debug.print("radio both", ap.ok, ap.error)
}

event.on("key.SELECT") {
  let stop = service.wifi.stopAP()
  service.upload.stop()
  debug.print("radio stop", stop.ok, stop.error)
}
