app "planned-sleep"

state {
  count: int = 0
}

event.on("app.start") {
  state.load()
  debug.print("start", system.startReason(), @count)
}

event.on("key.SELECT") {
  @count = @count + 1
  service.power.sleep({ wakeAfterMs: 1500 })
}

event.on("power.sleep") {
  debug.print("sleep", @count)
  state.save()
}
