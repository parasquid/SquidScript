app "indicator-state-summary"

event.on("app.start") {
  service.indicator.write(false)
  let off = service.indicator.read()
  debug.print("indicator read off", off)

  service.indicator.toggle()
  let on = service.indicator.read()
  debug.print("indicator read on", on)

  service.indicator.toggle()
  let offAgain = service.indicator.read()
  debug.print("indicator read off again", offAgain)
}
