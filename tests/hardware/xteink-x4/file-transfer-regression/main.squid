app "file-transfer-regression"

event.on("app.start") {
  let ap = service.wifi.startAP("SquidScript-X4")
  service.upload.start({
    id: "file-transfer"
    accept: [".binbook", ".sqbc"]
    transports: ["http", "ble"]
    events: {
      complete: "upload.complete"
    }
  })
  debug.print("transfer ready", ap.ok, ap.error)
}

event.on("upload.complete", ev) {
  debug.print("upload done", ev.transport, ev.bytesReceived, ev.totalBytes)
  let copied = file.copy(ev.upload, {
    library: "books"
    name: ev.name
  })
  debug.print("upload copy", ev.transport, copied.ok, copied.error, copied.bytesWritten)
}
