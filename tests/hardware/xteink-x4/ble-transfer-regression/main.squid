app "ble-transfer-regression"

event.on("app.start") {
  service.upload.start({
    id: "ble-transfer"
    accept: [".binbook", ".sqbc"]
    transports: ["ble"]
    events: {
      complete: "upload.complete"
    }
  })
  debug.print("transfer ready")
}

event.on("upload.complete", ev) {
  debug.print("upload done", ev.bytesReceived, ev.totalBytes, ev.transport)
  let copied = file.copy(ev.upload, {
    library: "books"
    name: ev.name
  })
  debug.print("upload copy", ev.transport, copied.ok, copied.error, copied.bytesWritten)
  service.upload.stop()
}
