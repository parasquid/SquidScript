app "radio-wifi-station"

state {
}

event.on("app.start") {
  let connect = service.wifi.connect("dev")
  debug.print("radio wifi connect", connect.ok, connect.error)
  service.timer.after("timer.radio.station", 250)
}

event.on("timer.radio.station") {
  let operation = service.wifi.operation()
  if
  operation.done {
    let status = service.wifi.status()
    debug.print("radio wifi station", status.profile, status.connected, status.state, status.error)
  }
  else {
    service.timer.after("timer.radio.station", 250)
  }
}

event.on("key.SELECT") {
  let disconnect = service.wifi.disconnect()
  debug.print("radio wifi disconnect", disconnect.ok, disconnect.error)
  service.timer.after("timer.radio.disc", 250)
}

event.on("timer.radio.disc") {
  let operation = service.wifi.operation()
  if
  operation.done {
    let status = service.wifi.status()
    debug.print("radio wifi disconnected", status.profile, status.connected, status.state, status.error)
  }
  else {
    service.timer.after("timer.radio.disc", 250)
  }
}
