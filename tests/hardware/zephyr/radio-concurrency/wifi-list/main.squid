app "radio-wifi-list"

state {
}

event.on("app.start") {
  service.wifi.scan()
  service.timer.after("timer.radio.wifi.list", 250)
}

event.on("timer.radio.wifi.list") {
  let result = service.wifi.result()
  if
  result.ready {
    debug.print("radio wifi list", result.ok, result.error, result.count)
    if
    result.count > 0 {
      let first = service.wifi.scanNetwork(0)
      debug.print("radio wifi ap", first.ssidLength, first.channel, first.rssi, first.auth, first.hidden)
    }
  }
  else {
    service.timer.after("timer.radio.wifi.list", 250)
  }
}
