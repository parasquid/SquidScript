:reset

state {
  count: int = 0
}

app.arm("break-reminder")
app.launch("reader")
app.disarm("break-reminder")
service.timer.after("timer.break", 250)
debug.print("lifecycle ok")
:output
:expect-output lifecycle ok
:trace
:expect-trace app.arm break-reminder
:expect-trace app.launch reader
:expect-trace app.disarm break-reminder
