:reset

state {
  count: int = 0
}

let status = service.wifi.status()
let scan = service.wifi.scan()
debug.print("wifi-status", status.state, status.backend, status.driverStarted, status.error)
debug.print("wifi-scan", scan.ok, scan.error, scan.count)
:output
:expect-output wifi-status stopped zephyr false unsupported
:expect-output wifi-scan false unsupported 0
