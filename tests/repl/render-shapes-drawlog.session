:reset

state {
  count: int = 0
}

:mode render
service.display.clear(color.GRAY0)
service.display.text("Hello", { x: 10, y: 20 })
service.display.rect(1, 2, 3, 4, { fillColor: color.GRAY4 })
service.display.line(5, 6, 7, 8, { color: color.GRAY15 })
:drawlog
:expect-draw draw=clear color=0
:expect-draw draw=text text="Hello" x=10 y=20
:expect-draw draw=rect x=1 y=2 w=3 h=4
:expect-draw draw=line x1=5 y1=6 x2=7 y2=8
