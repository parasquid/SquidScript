{
    "format": "squid-capability-contract-v1",
    "namespace": "binbook",
    "version": "0.2",
    "status": "draft",
    "kind": "standard-domain-capability",
    "summary": "Read BinBook v0.1 compiled raster-book documents through firmware-owned handles and display-ready drawables.",
    "sourceSpecs": [
        {
            "name": "BinBook Format Specification v0.1",
            "url": "https://github.com/parasquid/binbook/blob/main/BINBOOK_FORMAT_SPEC.md",
            "scope": "Defines the .binbook binary container, sections, pixel formats, compression, validation rules, and xteink-x4-portrait profile."
        },
        {
            "name": "SquidScript Language Specification v0.2 Draft",
            "repoPath": "squidscript/docs/language_spec.md",
            "scope": "Defines SquidScript values, handles, API availability, render safety, bytecode validation, and capability calls."
        }
    ],
    "feature": "binbook.read",
    "targetRequirements": {
        "features": [
            "binbook.read",
            "service.display.draw"
        ]
    },
    "capabilityConstraints": {
        "binbook": {
            "description": "BinBook-specific constraints consumed by BinBook-aware validators and firmware modules, not by the generic capability-contract loader.",
            "acceptableStoragePixelFormats": [
                "GRAY1_PACKED",
                "GRAY2_PACKED"
            ],
            "preferredStoragePixelFormat": "GRAY2_PACKED",
            "supportedCompressionMethods": [
                "NONE",
                "RLE_PACKBITS"
            ],
            "profiles": [
                {
                    "id": "xteink-x4-portrait",
                    "logicalWidth": 480,
                    "logicalHeight": 800,
                    "physicalWidth": 800,
                    "physicalHeight": 480,
                    "logicalToPhysicalRotation": 90,
                    "defaultStoragePixelFormat": "GRAY2_PACKED",
                    "explicitLowerQualityStoragePixelFormat": "GRAY1_PACKED",
                    "rejectedStoragePixelFormats": [
                        "GRAY4_PACKED"
                    ]
                }
            ]
        }
    },
    "compilerResponsibilities": [
        "Resolve binbook.* calls against this contract.",
        "Validate argument count and argument types.",
        "Infer return types for records, handles, primitive values, and drawables.",
        "",
        "Require binbook.read target feature when binbook.* calls are present.",
        "Reject calls from render-pure screen blocks unless the function is renderSafe.",
        "Emit stable builtin IDs into .sqbc rather than source strings.",
        "Do not parse, validate, decode, or reinterpret .binbook bytes."
    ],
    "vmResponsibilities": [
        "Validate builtin IDs, stack effects, handle types, API availability, and target feature availability before execution.",
        "Dispatch binbook.* calls to the firmware BinBook module.",
        "Stop the current app with a structured runtime error on invalid handles, invalid documents, API availability failures, out-of-range pages, unsupported features, decode failures, or resource exhaustion.",
        "Release transient handles according to SquidScript handle lifetime rules."
    ],
    "firmwareModuleResponsibilities": [
        "Open and validate .binbook files.",
        "Validate BinBook header, section table, required sections, reader requirements, page index, nav index, string refs, CRCs when present, and profile-specific constraints.",
        "Read metadata from BOOK_METADATA, DISPLAY_PROFILE, LAYOUT_PROFILE, READER_REQUIREMENTS, and related sections.",
        "Resolve page records from PAGE_INDEX.",
        "Resolve navigation records from NAV_INDEX.",
        "Read PAGE_DATA blobs by relative blob offset.",
        "Decompress NONE and RLE_PACKBITS page blobs when supported.",
        "Validate decompressed size and page CRC32 when present.",
        "Convert canonical BinBook pixels into display-ready drawable resources.",
        "Apply target-specific tiling, memory management, and logical-to-physical display conversion as needed."
    ],
    "types": {
        "handles": [
            {
                "name": "binbook.book",
                "description": "Opaque firmware-owned handle to an opened and validated BinBook document.",
                "lifetime": "current event or render turn unless a future API explicitly promotes it to an app-session handle",
                "serializable": false,
                "comparable": false,
                "persistentStateAllowed": false
            },
            {
                "name": "binbook.page",
                "description": "Opaque firmware-owned handle to a resolved BinBook page record and its page-data reference.",
                "lifetime": "current event or render turn",
                "serializable": false,
                "comparable": false,
                "persistentStateAllowed": false
            }
        ],
        "records": [
            {
                "name": "binbook.info",
                "sourceSections": [
                    "BOOK_METADATA",
                    "DISPLAY_PROFILE",
                    "LAYOUT_PROFILE",
                    "READER_REQUIREMENTS"
                ],
                "fields": [
                    {
                        "name": "title",
                        "type": "string",
                        "source": "BOOK_METADATA.title"
                    },
                    {
                        "name": "subtitle",
                        "type": "string",
                        "source": "BOOK_METADATA.subtitle"
                    },
                    {
                        "name": "author",
                        "type": "string",
                        "source": "BOOK_METADATA.author"
                    },
                    {
                        "name": "publisher",
                        "type": "string",
                        "source": "BOOK_METADATA.publisher"
                    },
                    {
                        "name": "language",
                        "type": "string",
                        "source": "BOOK_METADATA.language"
                    },
                    {
                        "name": "seriesName",
                        "type": "string",
                        "source": "BOOK_METADATA.series_name"
                    },
                    {
                        "name": "seriesIndexMilli",
                        "type": "int",
                        "source": "BOOK_METADATA.series_index_milli"
                    },
                    {
                        "name": "pageCount",
                        "type": "int",
                        "source": "PAGE_INDEX.record_count"
                    },
                    {
                        "name": "navCount",
                        "type": "int",
                        "source": "NAV_INDEX.record_count"
                    },
                    {
                        "name": "logicalWidth",
                        "type": "int",
                        "source": "DISPLAY_PROFILE.logical_width_px"
                    },
                    {
                        "name": "logicalHeight",
                        "type": "int",
                        "source": "DISPLAY_PROFILE.logical_height_px"
                    },
                    {
                        "name": "physicalWidth",
                        "type": "int",
                        "source": "DISPLAY_PROFILE.physical_width_px"
                    },
                    {
                        "name": "physicalHeight",
                        "type": "int",
                        "source": "DISPLAY_PROFILE.physical_height_px"
                    },
                    {
                        "name": "logicalToPhysicalRotation",
                        "type": "int",
                        "source": "DISPLAY_PROFILE.logical_to_physical_rotation"
                    },
                    {
                        "name": "defaultPixelFormat",
                        "type": "string",
                        "source": "DISPLAY_PROFILE.framebuffer_bits_per_pixel and ReaderRequirements.required_storage_pixel_formats"
                    },
                    {
                        "name": "compression",
                        "type": "string",
                        "source": "COMPRESSION_POLICY.default_compression_method"
                    }
                ],
                "mutable": false,
                "serializable": false
            },
            {
                "name": "binbook.pageInfo",
                "sourceSections": [
                    "PAGE_INDEX"
                ],
                "fields": [
                    {
                        "name": "pageNumber",
                        "type": "int",
                        "source": "PageIndexEntry.page_number"
                    },
                    {
                        "name": "pageKind",
                        "type": "string",
                        "source": "PageIndexEntry.page_kind"
                    },
                    {
                        "name": "pixelFormat",
                        "type": "string",
                        "source": "PageIndexEntry.pixel_format"
                    },
                    {
                        "name": "compressionMethod",
                        "type": "string",
                        "source": "PageIndexEntry.compression_method"
                    },
                    {
                        "name": "storedWidth",
                        "type": "int",
                        "source": "PageIndexEntry.stored_width"
                    },
                    {
                        "name": "storedHeight",
                        "type": "int",
                        "source": "PageIndexEntry.stored_height"
                    },
                    {
                        "name": "placementX",
                        "type": "int",
                        "source": "PageIndexEntry.placement_x"
                    },
                    {
                        "name": "placementY",
                        "type": "int",
                        "source": "PageIndexEntry.placement_y"
                    },
                    {
                        "name": "progressStartPpm",
                        "type": "int",
                        "source": "PageIndexEntry.progress_start_ppm"
                    },
                    {
                        "name": "progressEndPpm",
                        "type": "int",
                        "source": "PageIndexEntry.progress_end_ppm"
                    },
                    {
                        "name": "chapterNavIndex",
                        "type": "int",
                        "source": "PageIndexEntry.chapter_nav_index, or -1 when UINT32_MAX"
                    }
                ],
                "mutable": false,
                "serializable": false
            },
            {
                "name": "binbook.navEntry",
                "sourceSections": [
                    "NAV_INDEX"
                ],
                "fields": [
                    {
                        "name": "navIndex",
                        "type": "int",
                        "source": "NavIndexEntry.nav_index"
                    },
                    {
                        "name": "navType",
                        "type": "string",
                        "source": "NavIndexEntry.nav_type"
                    },
                    {
                        "name": "level",
                        "type": "int",
                        "source": "NavIndexEntry.level"
                    },
                    {
                        "name": "title",
                        "type": "string",
                        "source": "NavIndexEntry.title"
                    },
                    {
                        "name": "renderedPageNumber",
                        "type": "int",
                        "source": "NavIndexEntry.rendered_page_number"
                    },
                    {
                        "name": "parentNavIndex",
                        "type": "int",
                        "source": "NavIndexEntry.parent_nav_index, or -1 when UINT32_MAX"
                    },
                    {
                        "name": "firstChildNavIndex",
                        "type": "int",
                        "source": "NavIndexEntry.first_child_nav_index, or -1 when UINT32_MAX"
                    },
                    {
                        "name": "nextSiblingNavIndex",
                        "type": "int",
                        "source": "NavIndexEntry.next_sibling_nav_index, or -1 when UINT32_MAX"
                    }
                ],
                "mutable": false,
                "serializable": false
            }
        ],
        "externalReturnTypes": [
            {
                "name": "drawable",
                "description": "Display-ready resource accepted by service.display.draw(drawable, options)."
            }
        ]
    },
    "functions": [
        {
            "name": "open",
            "qualifiedName": "binbook.open",
            "builtinId": "BINBOOK_OPEN",
            "args": [
                {
                    "name": "path",
                    "type": "string"
                }
            ],
            "returns": "handle<binbook.book>",
            "targetFeatures": [
                "binbook.read"
            ],
            "renderSafe": true,
            "handleBehavior": "creates handle<binbook.book>",
            "errors": [
                "fileNotFound",
                "invalidMagic",
                "unsupportedVersion",
                "missingRequiredSection",
                "unsupportedRequiredFeature",
                "unsupportedPixelFormat",
                "unsupportedCompressionMethod",
                "invalidProfile",
                "invalidStringRef",
                "crcMismatch",
                "outOfMemory",
                "ioError"
            ]
        },
        {
            "name": "inspect",
            "qualifiedName": "binbook.inspect",
            "builtinId": "BINBOOK_INSPECT_UPLOAD",
            "args": [
                {
                    "name": "upload",
                    "type": "handle<upload>"
                }
            ],
            "returns": "record<binbook.info>",
            "targetFeatures": [
                "binbook.read"
            ],
            "renderSafe": true,
            "handleBehavior": "does not create handles",
            "errors": [
                "invalidHandle",
                "uploadIncomplete",
                "invalidMagic",
                "unsupportedVersion",
                "missingRequiredSection",
                "unsupportedRequiredFeature",
                "unsupportedPixelFormat",
                "unsupportedCompressionMethod",
                "invalidProfile",
                "invalidStringRef",
                "crcMismatch",
                "outOfMemory",
                "ioError"
            ]
        },
        {
            "name": "info",
            "qualifiedName": "binbook.info",
            "builtinId": "BINBOOK_INFO",
            "args": [
                {
                    "name": "book",
                    "type": "handle<binbook.book>"
                }
            ],
            "returns": "record<binbook.info>",
            "targetFeatures": [
                "binbook.read"
            ],
            "renderSafe": true,
            "handleBehavior": "does not create handles",
            "errors": [
                "invalidHandle",
                "documentClosed",
                "ioError"
            ]
        },
        {
            "name": "pageCount",
            "qualifiedName": "binbook.pageCount",
            "builtinId": "BINBOOK_PAGE_COUNT",
            "args": [
                {
                    "name": "book",
                    "type": "handle<binbook.book>"
                }
            ],
            "returns": "int",
            "targetFeatures": [
                "binbook.read"
            ],
            "renderSafe": true,
            "handleBehavior": "does not create handles",
            "errors": [
                "invalidHandle",
                "documentClosed"
            ]
        },
        {
            "name": "pageInfo",
            "qualifiedName": "binbook.pageInfo",
            "builtinId": "BINBOOK_PAGE_INFO",
            "args": [
                {
                    "name": "book",
                    "type": "handle<binbook.book>"
                },
                {
                    "name": "pageIndex",
                    "type": "int"
                }
            ],
            "returns": "record<binbook.pageInfo>",
            "targetFeatures": [
                "binbook.read"
            ],
            "renderSafe": true,
            "handleBehavior": "does not create handles",
            "errors": [
                "invalidHandle",
                "documentClosed",
                "pageOutOfRange"
            ]
        },
        {
            "name": "page",
            "qualifiedName": "binbook.page",
            "builtinId": "BINBOOK_PAGE",
            "args": [
                {
                    "name": "book",
                    "type": "handle<binbook.book>"
                },
                {
                    "name": "pageIndex",
                    "type": "int"
                }
            ],
            "returns": "handle<binbook.page>",
            "targetFeatures": [
                "binbook.read"
            ],
            "renderSafe": true,
            "handleBehavior": "creates handle<binbook.page>",
            "errors": [
                "invalidHandle",
                "documentClosed",
                "pageOutOfRange",
                "outOfMemory"
            ]
        },
        {
            "name": "pageImage",
            "qualifiedName": "binbook.pageImage",
            "builtinId": "BINBOOK_PAGE_IMAGE",
            "args": [
                {
                    "name": "page",
                    "type": "handle<binbook.page>"
                }
            ],
            "returns": "drawable",
            "targetFeatures": [
                "binbook.read",
                "service.display.draw"
            ],
            "renderSafe": true,
            "handleBehavior": "creates transient drawable owned by the render/event turn",
            "errors": [
                "invalidHandle",
                "documentClosed",
                "unsupportedPixelFormat",
                "unsupportedCompressionMethod",
                "decodeFailed",
                "sizeMismatch",
                "crcMismatch",
                "outOfMemory"
            ]
        },
        {
            "name": "navCount",
            "qualifiedName": "binbook.navCount",
            "builtinId": "BINBOOK_NAV_COUNT",
            "args": [
                {
                    "name": "book",
                    "type": "handle<binbook.book>"
                }
            ],
            "returns": "int",
            "targetFeatures": [
                "binbook.read"
            ],
            "renderSafe": true,
            "handleBehavior": "does not create handles",
            "errors": [
                "invalidHandle",
                "documentClosed"
            ]
        },
        {
            "name": "navEntry",
            "qualifiedName": "binbook.navEntry",
            "builtinId": "BINBOOK_NAV_ENTRY",
            "args": [
                {
                    "name": "book",
                    "type": "handle<binbook.book>"
                },
                {
                    "name": "navIndex",
                    "type": "int"
                }
            ],
            "returns": "record<binbook.navEntry>",
            "targetFeatures": [
                "binbook.read"
            ],
            "renderSafe": true,
            "handleBehavior": "does not create handles",
            "errors": [
                "invalidHandle",
                "documentClosed",
                "navOutOfRange"
            ]
        },
        {
            "name": "close",
            "qualifiedName": "binbook.close",
            "builtinId": "BINBOOK_CLOSE",
            "args": [
                {
                    "name": "book",
                    "type": "handle<binbook.book>"
                }
            ],
            "returns": "null",
            "targetFeatures": [
                "binbook.read"
            ],
            "renderSafe": false,
            "handleBehavior": "releases handle<binbook.book> and invalidates dependent page handles",
            "errors": [
                "invalidHandle",
                "documentClosed"
            ]
        }
    ],
    "diagnosticCodes": [
        "SQUID_BINBOOK_PERMISSION_REQUIRED",
        "SQUID_BINBOOK_TARGET_FEATURE_REQUIRED",
        "SQUID_BINBOOK_INVALID_HANDLE_TYPE",
        "SQUID_BINBOOK_RENDER_UNSAFE_CALL",
        "SQUID_BINBOOK_PAGE_INDEX_NOT_INT",
        "SQUID_BINBOOK_NAV_INDEX_NOT_INT",
        "SQUID_BINBOOK_UNSUPPORTED_PIXEL_FORMAT",
        "SQUID_BINBOOK_UNSUPPORTED_COMPRESSION",
        "SQUID_BINBOOK_INVALID_PROFILE"
    ],
    "notes": [
        "This contract is a source/spec/build artifact. It must not be embedded as JSON in .sqbc.",
        "The compiler depends on this contract, not on BinBook parser or decoder source code.",
        "The firmware BinBook module depends on BINBOOK_FORMAT_SPEC.md for binary validation and decoding behavior.",
        "Function builtinId values are symbolic until assigned numeric values by the SQBC builtin registry.",
        "Read-only BinBook operations are renderSafe because they are side-effect-free from the app's perspective, but firmware must still enforce target-definition limits for file IO, validation, decoding, handle count, and drawable memory."
    ]
}
