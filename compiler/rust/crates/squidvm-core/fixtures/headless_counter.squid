app "headless-counter" target "esp32c3-super-mini"

state {
  stateVersion: int = 1
  count: int = 0
  started: int = 0
}

event.on("app.start") {
  state.load()
  if (stateVersion != 1) {
    state.reset()
    stateVersion = 1
  }
  started = 1
  state.save()
}

event.on("key.SELECT") {
  count = count + 1
  state.save()
}

event.on("key.BACK") {
  app.exit()
}

screen("noop") {
}
