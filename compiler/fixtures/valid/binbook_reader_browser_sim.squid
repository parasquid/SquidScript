app "binbook-reader" target "xteink-x4"

state {
  selected: int = 0
}

event.on("app.start") {
  screen.open("main")
}

event.on("key.DOWN") {
  selected = selected + 1
  state.save()
  screen.refresh()
}

event.on("key.UP") {
  selected = selected - 1
  state.save()
  screen.refresh()
}

event.on("key.SELECT") {
  screen.open("detail")
}

event.on("key.BACK") {
  app.exit()
}

screen("main", { render: "compose" }) {
  service.display.clear("gray0")
  service.display.text("BinBook Reader", { x: 20, y: 60, w: 440, h: 48, fontHeight: 32, align: "center" })
  service.display.text("Browse Books", { x: 32, y: 160, w: 416, h: 48, fontHeight: 22, align: "center" })
  service.display.text("Resume Sample", { x: 32, y: 216, w: 416, h: 48, fontHeight: 22, align: "center" })
  service.display.text("Table of Contents", { x: 32, y: 272, w: 416, h: 48, fontHeight: 22, align: "center" })
  service.display.text("Jump to Page", { x: 32, y: 328, w: 416, h: 48, fontHeight: 22, align: "center" })
}

screen("detail") {
  service.display.clear("gray0")
  service.display.text("BinBook support is not implemented in browser-sim yet.", { x: 32, y: 160, w: 416, h: 96, fontHeight: 22, align: "center" })
}
