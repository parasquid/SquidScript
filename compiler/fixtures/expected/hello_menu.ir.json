{
  "format": "squidscript-ir",
  "version": 1,
  "app": {
    "id": "hello-menu",
    "name": "Hello Menu",
    "target": "xteink-x4"
  },
  "state": [
    {
      "name": "selected",
      "value": 0
    }
  ],
  "functions": [],
  "handlers": [
    {
      "event": "onStart",
      "statements": [
        {
          "op": "state.load"
        },
        {
          "op": "screen.open",
          "screen": "main"
        }
      ]
    },
    {
      "event": "onKey.DOWN",
      "statements": [
        {
          "op": "assign",
          "name": "selected",
          "expr": {
            "op": "binary",
            "left": {
              "op": "state",
              "name": "selected"
            },
            "operator": "+",
            "right": {
              "op": "literal",
              "value": 1
            }
          }
        },
        {
          "op": "state.save"
        },
        {
          "op": "screen.refresh"
        }
      ]
    },
    {
      "event": "onKey.UP",
      "statements": [
        {
          "op": "assign",
          "name": "selected",
          "expr": {
            "op": "binary",
            "left": {
              "op": "state",
              "name": "selected"
            },
            "operator": "-",
            "right": {
              "op": "literal",
              "value": 1
            }
          }
        },
        {
          "op": "state.save"
        },
        {
          "op": "screen.refresh"
        }
      ]
    },
    {
      "event": "onKey.SELECT",
      "statements": [
        {
          "op": "screen.open",
          "screen": "detail"
        }
      ]
    },
    {
      "event": "onKey.BACK",
      "statements": [
        {
          "op": "app.exit"
        }
      ]
    }
  ],
  "screens": [
    {
      "name": "main",
      "render": "compose",
      "statements": [
        {
          "op": "display.clear",
          "color": "gray0"
        },
        {
          "op": "display.text",
          "text": "Hello Menu",
          "options": {
            "x": 20,
            "y": 60,
            "w": 440,
            "h": 48,
            "fontHeight": 32,
            "align": "center"
          }
        },
        {
          "op": "display.text",
          "text": "Say Hello",
          "options": {
            "x": 32,
            "y": 160,
            "w": 416,
            "h": 48,
            "fontHeight": 22,
            "align": "center"
          }
        },
        {
          "op": "display.text",
          "text": "About",
          "options": {
            "x": 32,
            "y": 216,
            "w": 416,
            "h": 48,
            "fontHeight": 22,
            "align": "center"
          }
        },
        {
          "op": "display.text",
          "text": "Exit",
          "options": {
            "x": 32,
            "y": 272,
            "w": 416,
            "h": 48,
            "fontHeight": 22,
            "align": "center"
          }
        },
        {
          "op": "display.text",
          "text": "UP/DOWN select  SELECT open",
          "options": {
            "x": 20,
            "y": 720,
            "w": 440,
            "h": 32,
            "fontHeight": 18,
            "align": "center",
            "textColor": "gray8"
          }
        }
      ]
    },
    {
      "name": "detail",
      "render": "compose",
      "statements": [
        {
          "op": "display.clear",
          "color": "gray0"
        },
        {
          "op": "display.text",
          "text": "Hello, Squid!",
          "options": {
            "x": 20,
            "y": 120,
            "w": 440,
            "h": 64,
            "fontHeight": 32,
            "align": "center"
          }
        },
        {
          "op": "display.text",
          "text": "BACK exits this example",
          "options": {
            "x": 20,
            "y": 720,
            "w": 440,
            "h": 32,
            "fontHeight": 18,
            "align": "center",
            "textColor": "gray8"
          }
        }
      ]
    }
  ]
}
