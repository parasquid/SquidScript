function loadBookInfo() {
  let book = binbook.open(state.file)
  let info = binbook.info(book)

  state.title = info.title
  state.pageCount = info.pageCount
  state.navCount = info.navCount

  if (state.pageCount <= 0) {
    state.pageIndex = 0
  } else {
    if (state.pageIndex >= state.pageCount) {
      state.pageIndex = state.pageCount - 1
    }
  }

  if (state.tocIndex >= state.navCount) {
    state.tocIndex = 0
    state.tocTop = 0
  }
}

function saveAndRefresh() {
  state.save()
  screen.refresh()
}

function openBrowser() {
  stateMachine.enter("uiState", "browser")
  screen.open("browser")
}

function browserPrevious() {
  if (state.browserIndex > 0) {
    state.browserIndex = state.browserIndex - 1
    saveAndRefresh()
  }
}

function browserNext() {
  if (state.file != "") {
    if (state.browserIndex < 1) {
      state.browserIndex = state.browserIndex + 1
      saveAndRefresh()
    }
  }
}

function openSelectedBrowserItem() {
  if (state.browserIndex == 0) {
    browseForBook()
  } else {
    resumeBook()
  }
}

function browseForBook() {
  let picked = content.pickFile(".binbook")

  if (picked != "") {
    state.file = picked
    state.pageIndex = 0
    state.tocIndex = 0
    state.tocTop = 0
    state.jumpPage = 1
    loadBookInfo()
    state.save()
    openReader()
  }
}

function resumeBook() {
  if (state.file != "") {
    loadBookInfo()
    state.save()
    openReader()
  }
}

function openToc() {
  if (state.tocIndex < state.tocTop) {
    state.tocTop = state.tocIndex
  }

  if (state.tocIndex >= state.tocTop + 8) {
    state.tocTop = state.tocIndex - 7
  }

  stateMachine.enter("uiState", "toc")
  screen.open("toc")
}

function openJump() {
  state.jumpPage = state.pageIndex + 1
  stateMachine.enter("uiState", "jump")
  screen.open("jump")
}

function openReader() {
  stateMachine.enter("uiState", "reader")
  screen.open("reader")
}

function handleUp() {
  if (stateMachine.is("uiState", "reader")) {
    previousChapter()
  } else {
    if (stateMachine.is("uiState", "toc")) {
      tocPrevious()
    } else {
      if (stateMachine.is("uiState", "jump")) {
        jumpForward1()
      } else {
        if (stateMachine.is("uiState", "browser")) {
          browserPrevious()
        }
      }
    }
  }
}

function handleDown() {
  if (stateMachine.is("uiState", "reader")) {
    nextChapter()
  } else {
    if (stateMachine.is("uiState", "toc")) {
      tocNext()
    } else {
      if (stateMachine.is("uiState", "jump")) {
        jumpBack1()
      } else {
        if (stateMachine.is("uiState", "browser")) {
          browserNext()
        }
      }
    }
  }
}

function handleSelect() {
  if (stateMachine.is("uiState", "reader")) {
    openJump()
  } else {
    if (stateMachine.is("uiState", "toc")) {
      openSelectedTocEntry()
    } else {
      if (stateMachine.is("uiState", "jump")) {
        commitJump()
      } else {
        if (stateMachine.is("uiState", "browser")) {
          openSelectedBrowserItem()
        }
      }
    }
  }
}

function previousPage() {
  if (state.pageIndex > 0) {
    state.pageIndex = state.pageIndex - 1
    saveAndRefresh()
  }
}

function nextPage() {
  if (state.pageIndex < state.pageCount - 1) {
    state.pageIndex = state.pageIndex + 1
    saveAndRefresh()
  }
}

function setPage(newPageIndex) {
  if (newPageIndex < 0) {
    state.pageIndex = 0
  } else {
    if (newPageIndex >= state.pageCount) {
      state.pageIndex = state.pageCount - 1
    } else {
      state.pageIndex = newPageIndex
    }
  }

  saveAndRefresh()
}

function nextChapter() {
  if (state.navCount > 0) {
    let book = binbook.open(state.file)
    let scan = state.tocIndex + 1

    repeat (32) {
      if (scan < state.navCount) {
        let entry = binbook.navEntry(book, scan)

        if (entry.renderedPageNumber > state.pageIndex) {
          state.tocIndex = scan
          setPage(entry.renderedPageNumber)
          return
        }

        scan = scan + 1
      }
    }
  }
}

function previousChapter() {
  if (state.navCount > 0) {
    let book = binbook.open(state.file)
    let scan = state.tocIndex - 1

    repeat (32) {
      if (scan >= 0) {
        let entry = binbook.navEntry(book, scan)

        if (entry.renderedPageNumber < state.pageIndex) {
          state.tocIndex = scan
          setPage(entry.renderedPageNumber)
          return
        }

        scan = scan - 1
      }
    }
  }
}

function tocPrevious() {
  if (state.tocIndex > 0) {
    state.tocIndex = state.tocIndex - 1

    if (state.tocIndex < state.tocTop) {
      state.tocTop = state.tocIndex
    }

    saveAndRefresh()
  }
}

function tocNext() {
  if (state.tocIndex < state.navCount - 1) {
    state.tocIndex = state.tocIndex + 1

    if (state.tocIndex >= state.tocTop + 8) {
      state.tocTop = state.tocTop + 1
    }

    saveAndRefresh()
  }
}

function openSelectedTocEntry() {
  if (state.navCount > 0) {
    let book = binbook.open(state.file)
    let entry = binbook.navEntry(book, state.tocIndex)

    state.pageIndex = entry.renderedPageNumber
    state.save()
    openReader()
  }
}

function jumpForward10() {
  if (state.jumpPage + 10 <= state.pageCount) {
    state.jumpPage = state.jumpPage + 10
  } else {
    state.jumpPage = state.pageCount
  }

  saveAndRefresh()
}

function jumpBack10() {
  if (state.jumpPage > 10) {
    state.jumpPage = state.jumpPage - 10
  } else {
    state.jumpPage = 1
  }

  saveAndRefresh()
}

function jumpForward1() {
  if (state.jumpPage < state.pageCount) {
    state.jumpPage = state.jumpPage + 1
    saveAndRefresh()
  }
}

function jumpBack1() {
  if (state.jumpPage > 1) {
    state.jumpPage = state.jumpPage - 1
    saveAndRefresh()
  }
}

function commitJump() {
  state.pageIndex = state.jumpPage - 1
  state.save()
  openReader()
}

function drawTopBar(label) {
  service.display.rect(0, 0, 480, 36, { fillColor: "gray0" })
  service.display.text(label, { x: 12, y: 8, w: 456, h: 24, fontHeight: 18 })
  service.display.line(0, 38, 480, 38, { color: "gray15" })
}

function drawBottomBar(label) {
  service.display.rect(0, 758, 480, 42, { fillColor: "gray0" })
  service.display.line(0, 758, 480, 758, { color: "gray15" })
  service.display.text(label, { x: 12, y: 770, w: 456, h: 24, fontHeight: 18, align: "right" })
}
