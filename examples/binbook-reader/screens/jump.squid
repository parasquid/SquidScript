screen("jump") {
  display.clear("white")
  drawTopBar("Jump to Page")

  display.text(string.format("{}", jumpPage), {
    x: 0,
    y: 260,
    w: 480,
    h: 80,
    size: "huge",
    align: "center"
  })

  display.text(string.format("of {}", pageCount), {
    x: 0,
    y: 350,
    w: 480,
    h: 40,
    size: "medium",
    align: "center"
  })

  display.text("LEFT/RIGHT -10/+10", { x: 40, y: 500, w: 400, h: 32, size: "small", align: "center" })
  display.text("DOWN/UP -1/+1", { x: 40, y: 540, w: 400, h: 32, size: "small", align: "center" })

  drawBottomBar("SELECT jump  BACK reader")
}
