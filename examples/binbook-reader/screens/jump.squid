screen("jump") {
  service.display.clear("white")
  drawTopBar("Jump to Page")

  service.display.text(string.format("{}", jumpPage), {
    x: 0,
    y: 260,
    w: 480,
    h: 80,
    fontHeight: 48,
    align: "center"
  })

  service.display.text(string.format("of {}", pageCount), {
    x: 0,
    y: 350,
    w: 480,
    h: 40,
    fontHeight: 24,
    align: "center"
  })

  service.display.text("LEFT/RIGHT -10/+10", { x: 40, y: 500, w: 400, h: 32, fontHeight: 18, align: "center" })
  service.display.text("DOWN/UP -1/+1", { x: 40, y: 540, w: 400, h: 32, fontHeight: 18, align: "center" })

  drawBottomBar("SELECT jump  BACK reader")
}
