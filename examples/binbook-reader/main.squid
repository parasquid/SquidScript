include "lib/ui.squid"
include "screens/browser.squid"
include "screens/reader.squid"
include "screens/toc.squid"
include "screens/jump.squid"

state {
  stateVersion: int = 1,
  file: string = "",
  title: string = "",
  pageIndex: int = 0,
  pageCount: int = 0,
  navCount: int = 0,
  tocIndex: int = 0,
  tocTop: int = 0,
  jumpPage: int = 1,
  browserIndex: int = 0,
  uiState: string = "browser"
}

event.on("app.start") {
  state.load()
  if (stateVersion != 1) {
    state.reset()
    stateVersion = 1
    state.save()
  }
  openBrowser()
}

event.on("app.exit") {
  state.save()
}

event.on("key.RIGHT") {
  if (stateMachine.is("uiState", "reader")) {
    nextPage()
  } else {
    if (stateMachine.is("uiState", "jump")) {
      jumpForward10()
    }
  }
}

event.on("key.LEFT") {
  if (stateMachine.is("uiState", "reader")) {
    previousPage()
  } else {
    if (stateMachine.is("uiState", "jump")) {
      jumpBack10()
    }
  }
}

event.on("key.UP") {
  handleUp()
}

event.on("key.DOWN") {
  handleDown()
}

event.on("key.SELECT") {
  handleSelect()
}

event.on("key.POWER") {
  if (stateMachine.is("uiState", "reader")) {
    openToc()
  } else {
    openReader()
  }
}

event.on("key.BACK") {
  if (stateMachine.is("uiState", "reader")) {
    openBrowser()
  } else {
    if (stateMachine.is("uiState", "browser")) {
      state.save()
      app.exit()
    } else {
      openReader()
    }
  }
}
