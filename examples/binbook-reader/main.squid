include "lib/ui.squid"
include "screens/browser.squid"
include "screens/reader.squid"
include "screens/toc.squid"
include "screens/jump.squid"

state {
  file: "",
  title: "",
  pageIndex: 0,
  pageCount: 0,
  navCount: 0,
  tocIndex: 0,
  tocTop: 0,
  jumpPage: 1,
  browserIndex: 0,
  uiState: "browser"
}

event.on("app.start") {
  state.load()
  openBrowser()
}

event.on("app.resume") {
  screen.refresh()
}

event.on("app.suspend") {
  state.save()
}

event.on("key.RIGHT") {
  if (stateMachine.is("uiState", "reader")) {
    nextPage()
  } else {
    if (stateMachine.is("uiState", "jump")) {
      jumpForward10()
    }
  }
}

event.on("key.LEFT") {
  if (stateMachine.is("uiState", "reader")) {
    previousPage()
  } else {
    if (stateMachine.is("uiState", "jump")) {
      jumpBack10()
    }
  }
}

event.on("key.UP") {
  handleUp()
}

event.on("key.DOWN") {
  handleDown()
}

event.on("key.SELECT") {
  handleSelect()
}

event.on("key.POWER") {
  if (stateMachine.is("uiState", "reader")) {
    openToc()
  } else {
    openReader()
  }
}

event.on("key.BACK") {
  if (stateMachine.is("uiState", "reader")) {
    openBrowser()
  } else {
    if (stateMachine.is("uiState", "browser")) {
      state.save()
      app.exit()
    } else {
      openReader()
    }
  }
}
