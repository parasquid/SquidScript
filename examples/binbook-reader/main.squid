include "lib/ui.squid"
include "screens/browser.squid"
include "screens/reader.squid"
include "screens/toc.squid"
include "screens/jump.squid"

state {
  file: "",
  title: "",
  pageIndex: 0,
  pageCount: 0,
  navCount: 0,
  tocIndex: 0,
  tocTop: 0,
  jumpPage: 1,
  browserIndex: 0,
  uiState: "browser"
}

onStart() {
  state.load()
  openBrowser()
}

onResume() {
  screen.refresh()
}

onSuspend() {
  state.save()
}

onKey("RIGHT") {
  if (stateMachine.is("uiState", "reader")) {
    nextPage()
  } else {
    if (stateMachine.is("uiState", "jump")) {
      jumpForward10()
    }
  }
}

onKey("LEFT") {
  if (stateMachine.is("uiState", "reader")) {
    previousPage()
  } else {
    if (stateMachine.is("uiState", "jump")) {
      jumpBack10()
    }
  }
}

onKey("UP") {
  handleUp()
}

onKey("DOWN") {
  handleDown()
}

onKey("SELECT") {
  handleSelect()
}

onKey("POWER") {
  if (stateMachine.is("uiState", "reader")) {
    openToc()
  } else {
    openReader()
  }
}

onKey("BACK") {
  if (stateMachine.is("uiState", "reader")) {
    openBrowser()
  } else {
    if (stateMachine.is("uiState", "browser")) {
      state.save()
      app.exit()
    } else {
      openReader()
    }
  }
}
