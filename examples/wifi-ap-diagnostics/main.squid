app "wifi-ap-diagnostics"

state {
  clients: int = 0
  previousClients: int = 0
  mode: int = 0
  ticks: int = 0
  led: bool = false
}

event.on("app.start") {
  state.clients = 0
  state.previousClients = 0
  state.mode = 0
  state.ticks = 0
  state.led = false
  service.indicator.breathe()

  let ap = service.wifi.startAP("SquidScript")
  let status = service.wifi.status()
  let ip = service.wifi.getAPIP()

  debug.print("wifi start", ap.ok, ap.error)
  debug.print("wifi status", status.active, status.mode, status.ssid, status.ipAddress, status.clients, status.error)
  debug.print("wifi state", status.state, status.backend, status.driverStarted, status.configured, status.driverMode, status.channel, status.lastBackendCode)
  debug.print("wifi events", status.apStartEvents, status.apStopEvents, status.probeEvents, status.staConnectedEvents, status.staDisconnectedEvents)
  debug.print("wifi ap ip", ip.ip, ip.gw, ip.netmask, ip.error)
  debug.print("scan or join the AP named SquidScript to exercise optional probe and client events")
  service.timer.every("timer.debug", 250)
}

event.on("timer.debug") {
  let status = service.wifi.status()

  state.previousClients = state.clients
  state.clients = status.clients

  if (state.clients <= 0) {
    if (state.previousClients > 0) {
      debug.print("wifi all clients disconnected")
    }
    state.mode = 0
    state.ticks = 0
    state.led = false
    service.indicator.breathe()
  }

  if (state.clients > 0) {
    if (state.previousClients == 0) {
      state.mode = 1
      state.ticks = 0
      debug.print("wifi connecting", state.clients)
    }

    if (state.mode == 1) {
      service.indicator.toggle()
      state.led = service.indicator.read()
      state.ticks = state.ticks + 1
      if (state.ticks >= 8) {
        state.mode = 2
        state.ticks = 0
        state.led = true
        service.indicator.write(state.led)
        debug.print("wifi connected", state.clients)
      }
    }

    if (state.mode == 2) {
      state.ticks = state.ticks + 1
      if (state.ticks == 8) {
        state.led = false
        service.indicator.write(state.led)
      }
      if (state.ticks >= 9) {
        state.led = true
        service.indicator.write(state.led)
        state.ticks = 0
      }
    }

  if (state.clients != state.previousClients) {
      debug.print("wifi clients", state.clients)
    }

    if (status.probeEvents > 0) {
      debug.print("wifi probe events", status.probeEvents)
    }
  }
}

event.on("key.SELECT") {
  let stop = service.wifi.stopAP()
  let status = service.wifi.status()

  debug.print("wifi stop", stop.ok, stop.error)
  debug.print("wifi status", status.active, status.mode, status.ssid, status.ipAddress, status.clients, status.error)
  debug.print("wifi state", status.state, status.backend, status.driverStarted, status.configured, status.driverMode, status.channel, status.lastBackendCode)
  debug.print("wifi events", status.apStartEvents, status.apStopEvents, status.probeEvents, status.staConnectedEvents, status.staDisconnectedEvents)
  state.clients = 0
  state.previousClients = 0
  state.mode = 0
  state.ticks = 0
  state.led = false
  service.indicator.breathe()
}

event.on("key.BACK") {
  service.wifi.stopAP()
  service.indicator.breathe()
  app.exit()
}
