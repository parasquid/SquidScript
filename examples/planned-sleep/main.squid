app "planned-sleep"

state {
  wakeCount: int = 0
}

event.on("app.start") {
  state.load()
  if system.startReason() == "wake" {
    state.wakeCount = state.wakeCount + 1
    state.save()
  }
  debug.print("start", system.startReason(), state.wakeCount)
  screen.open("status")
}

event.on("key.POWER") {
  service.power.sleep({ wakeAfterMs: 3000 })
}

event.on("power.sleep") {
  state.save()
}

screen("status") {
  service.display.clear(color.WHITE)
  service.display.text("Planned sleep", {
    x: 24,
    y: 64,
    fontHeight: 24,
    textColor: color.GRAY15
  })
  service.display.text(system.startReason(), {
    x: 24,
    y: 112,
    fontHeight: 20,
    textColor: color.GRAY15
  })
  service.display.refreshMode("full")
}
