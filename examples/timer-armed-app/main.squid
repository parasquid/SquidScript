app "timer-main"

state {
  stateVersion: int = 1
  started: int = 0
}

event.on("app.start") {
  state.load()
  if (state.stateVersion != 1) {
    state.reset()
    state.stateVersion = 1
  }
  state.started = state.started + 1
  debug.print("main start", state.started)
  app.arm("timer-armed-app")
  state.save()
}
