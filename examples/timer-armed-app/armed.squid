app "timer-armed-app"

state {
  stateVersion: int = 1
  ticks: int = 0
}

app.triggers {
  service.timer.every("timer.debug", 1000)
}

event.on("timer.debug") {
  state.load()
  if (state.stateVersion != 1) {
    state.reset()
    state.stateVersion = 1
  }
  state.ticks = state.ticks + 1
  debug.print("armed timer", state.ticks)
  state.save()
  app.exit()
}
