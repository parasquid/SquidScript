app "ble-install"

state {
  stateVersion: int = 1
  received: int = 0
  installed: int = 0
}

event.on("app.start") {
  state.load()
  if (state.stateVersion != 1) {
    state.reset()
    state.stateVersion = 1
  }
  state.save()
  service.upload.start({
    id: "sqbc-install"
    accept: [".sqbc"]
    transports: ["ble"]
    events: {
      complete: "upload.complete"
    }
  })
  debug.print("ble-install ready")
}

event.on("upload.complete", ev) {
  state.load()
  state.received = state.received + 1
  debug.print("received file", ev.transport, state.received)
  let installed = app.install(ev.upload)
  app.launch(installed.id)
  state.installed = state.installed + 1
  state.save()
}
