app "ble-install"

state {
  stateVersion: int = 1
  received: int = 0
  installed: int = 0
}

event.on("app.start") {
  state.load()
  if (state.stateVersion != 1) {
    state.reset()
    state.stateVersion = 1
  }
  state.save()
  service.ble.start("file-transfer", {
    id: "sqbc-install"
    accept: [".sqbc"]
    events: {
      complete: "ble.file.complete"
    }
  })
  debug.print("ble-install ready")
}

event.on("ble.file.complete", ev) {
  state.load()
  state.received = state.received + 1
  debug.print("received file", state.received)
  let installed = app.install(ev.upload)
  app.launch(installed.id)
  state.installed = state.installed + 1
  state.save()
}
