app "binbook-two-page"

state {
  bookRef: string = ""
  page: int = 0
  pageCount: int = 0
}

event.on("app.start") {
  state.bookRef = "content:books/r/reader-one.binbook"
  let opened = binbook.open(state.bookRef)
  if (opened.ok) {
    let info = binbook.info(opened.book)
    if (info.ok) {
      state.pageCount = info.pageCount
    }
  }
  state.save()
  screen.open("page")
}

event.on("key.RIGHT") {
  if (state.pageCount > 0) {
    state.page = (state.page + 1) % state.pageCount
    state.save()
    screen.refresh()
  }
}

event.on("key.LEFT") {
  if (state.pageCount > 0) {
    state.page = (state.page + 1) % state.pageCount
    state.save()
    screen.refresh()
  }
}

event.on("key.BACK") {
  app.exit()
}

screen("page") {
  service.display.clear(color.WHITE)
  let opened = binbook.open(state.bookRef)
  if (opened.ok) {
    let page = binbook.readPage(opened.book, state.page)
    if (page.ok) {
      service.display.draw(page.drawable)
    }
    else {
      service.display.text("Page failed", { x: 24, y: 64, fontHeight: 24, textColor: color.GRAY15 })
    }
  }
  else {
    service.display.text("Open failed", { x: 24, y: 64, fontHeight: 24, textColor: color.GRAY15 })
  }
  service.display.refreshMode("fast1bpp")
}
