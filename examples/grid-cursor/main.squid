app "grid-cursor"

state {
  cursorRow: int = 0
  cursorCol: int = 0
}

event.on("app.start") {
  state.load()
  screen.open("grid")
}

event.on("key.UP") {
  if (state.cursorRow > 0) {
    state.cursorRow = state.cursorRow - 1
    state.save()
    screen.refresh()
  }
}

event.on("key.DOWN") {
  if (state.cursorRow < 4) {
    state.cursorRow = state.cursorRow + 1
    state.save()
    screen.refresh()
  }
}

event.on("key.LEFT") {
  if (state.cursorCol > 0) {
    state.cursorCol = state.cursorCol - 1
    state.save()
    screen.refresh()
  }
}

event.on("key.RIGHT") {
  if (state.cursorCol < 4) {
    state.cursorCol = state.cursorCol + 1
    state.save()
    screen.refresh()
  }
}

event.on("key.BACK") {
  app.exit()
}

function isSelected(row, col) {
  if (state.cursorRow == row) {
    if (state.cursorCol == col) {
      return true
    }
  }
  return false
}

function drawRow0() {
  if (isSelected(0, 0)) {
    service.display.rect(40, 200, 80, 80, { fillColor: color.BLACK })
    service.display.rect(48, 208, 64, 64, { fillColor: color.WHITE })
  }
  else {
    service.display.rect(48, 208, 64, 64, { fillColor: color.GRAY15 })
  }
  if (isSelected(0, 1)) {
    service.display.rect(120, 200, 80, 80, { fillColor: color.BLACK })
    service.display.rect(128, 208, 64, 64, { fillColor: color.WHITE })
  }
  else {
    service.display.rect(128, 208, 64, 64, { fillColor: color.GRAY15 })
  }
  if (isSelected(0, 2)) {
    service.display.rect(200, 200, 80, 80, { fillColor: color.BLACK })
    service.display.rect(208, 208, 64, 64, { fillColor: color.WHITE })
  }
  else {
    service.display.rect(208, 208, 64, 64, { fillColor: color.GRAY15 })
  }
  if (isSelected(0, 3)) {
    service.display.rect(280, 200, 80, 80, { fillColor: color.BLACK })
    service.display.rect(288, 208, 64, 64, { fillColor: color.WHITE })
  }
  else {
    service.display.rect(288, 208, 64, 64, { fillColor: color.GRAY15 })
  }
  if (isSelected(0, 4)) {
    service.display.rect(360, 200, 80, 80, { fillColor: color.BLACK })
    service.display.rect(368, 208, 64, 64, { fillColor: color.WHITE })
  }
  else {
    service.display.rect(368, 208, 64, 64, { fillColor: color.GRAY15 })
  }
}

function drawRow1() {
  if (isSelected(1, 0)) {
    service.display.rect(40, 280, 80, 80, { fillColor: color.BLACK })
    service.display.rect(44, 284, 72, 72, { strokeColor: color.WHITE })
  }
  else {
    service.display.rect(44, 284, 72, 72, { strokeColor: color.GRAY15 })
  }
  if (isSelected(1, 1)) {
    service.display.rect(120, 280, 80, 80, { fillColor: color.BLACK })
    service.display.rect(124, 284, 72, 72, { strokeColor: color.WHITE })
  }
  else {
    service.display.rect(124, 284, 72, 72, { strokeColor: color.GRAY15 })
  }
  if (isSelected(1, 2)) {
    service.display.rect(200, 280, 80, 80, { fillColor: color.BLACK })
    service.display.rect(204, 284, 72, 72, { strokeColor: color.WHITE })
  }
  else {
    service.display.rect(204, 284, 72, 72, { strokeColor: color.GRAY15 })
  }
  if (isSelected(1, 3)) {
    service.display.rect(280, 280, 80, 80, { fillColor: color.BLACK })
    service.display.rect(284, 284, 72, 72, { strokeColor: color.WHITE })
  }
  else {
    service.display.rect(284, 284, 72, 72, { strokeColor: color.GRAY15 })
  }
  if (isSelected(1, 4)) {
    service.display.rect(360, 280, 80, 80, { fillColor: color.BLACK })
    service.display.rect(364, 284, 72, 72, { strokeColor: color.WHITE })
  }
  else {
    service.display.rect(364, 284, 72, 72, { strokeColor: color.GRAY15 })
  }
}

function drawLetterCell(row, col, cellX, cellY, textX, textY, label) {
  if (isSelected(row, col)) {
    service.display.rect(cellX, cellY, 80, 80, { fillColor: color.BLACK })
    service.display.text(label, { x: textX, y: textY, fontHeight: 48, textColor: color.WHITE })
  }
  else {
    service.display.text(label, { x: textX, y: textY, fontHeight: 48, textColor: color.GRAY15 })
  }
}

function drawRow2() {
  drawLetterCell(2, 0, 40, 360, 60, 376, "A")
  drawLetterCell(2, 1, 120, 360, 140, 376, "A")
  drawLetterCell(2, 2, 200, 360, 220, 376, "A")
  drawLetterCell(2, 3, 280, 360, 300, 376, "A")
  drawLetterCell(2, 4, 360, 360, 380, 376, "A")
}

function drawRow3() {
  drawLetterCell(3, 0, 40, 440, 60, 456, "X")
  drawLetterCell(3, 1, 120, 440, 140, 456, "X")
  drawLetterCell(3, 2, 200, 440, 220, 456, "X")
  drawLetterCell(3, 3, 280, 440, 300, 456, "X")
  drawLetterCell(3, 4, 360, 440, 380, 456, "X")
}

function drawRow4() {
  if (isSelected(4, 0)) {
    service.display.rect(40, 520, 80, 80, { fillColor: color.BLACK })
    service.display.rect(60, 540, 40, 40, { fillColor: color.WHITE })
  }
  else {
    service.display.rect(60, 540, 40, 40, { fillColor: color.GRAY15 })
  }
  if (isSelected(4, 1)) {
    service.display.rect(120, 520, 80, 80, { fillColor: color.BLACK })
    service.display.rect(140, 540, 40, 40, { fillColor: color.WHITE })
  }
  else {
    service.display.rect(140, 540, 40, 40, { fillColor: color.GRAY15 })
  }
  if (isSelected(4, 2)) {
    service.display.rect(200, 520, 80, 80, { fillColor: color.BLACK })
    service.display.rect(220, 540, 40, 40, { fillColor: color.WHITE })
  }
  else {
    service.display.rect(220, 540, 40, 40, { fillColor: color.GRAY15 })
  }
  if (isSelected(4, 3)) {
    service.display.rect(280, 520, 80, 80, { fillColor: color.BLACK })
    service.display.rect(300, 540, 40, 40, { fillColor: color.WHITE })
  }
  else {
    service.display.rect(300, 540, 40, 40, { fillColor: color.GRAY15 })
  }
  if (isSelected(4, 4)) {
    service.display.rect(360, 520, 80, 80, { fillColor: color.BLACK })
    service.display.rect(380, 540, 40, 40, { fillColor: color.WHITE })
  }
  else {
    service.display.rect(380, 540, 40, 40, { fillColor: color.GRAY15 })
  }
}

screen("grid") {
  service.display.clear(color.WHITE)
  service.display.text("Grid Cursor", { x: 24, y: 28, fontHeight: 28, textColor: color.GRAY15 })
  service.display.text("X:", { x: 300, y: 28, fontHeight: 28, textColor: color.GRAY15 })
  service.display.text(state.cursorCol, { x: 350, y: 28, fontHeight: 28, textColor: color.GRAY15 })
  service.display.text("Y:", { x: 390, y: 28, fontHeight: 28, textColor: color.GRAY15 })
  service.display.text(state.cursorRow, { x: 440, y: 28, fontHeight: 28, textColor: color.GRAY15 })
  drawRow0()
  drawRow1()
  drawRow2()
  drawRow3()
  drawRow4()
  service.display.refreshMode("fast1bpp")
  debug.print("cursor", state.cursorRow, state.cursorCol)
}
