  }
  if (isSelected(0, 2)) {
    service.display.rect(200, 200, 80, 80, { fillColor: "black" })
    service.display.rect(208, 208, 64, 64, { fillColor: "white" })
  }
  else {
    service.display.rect(208, 208, 64, 64, { fillColor: "gray15" })
  }
  if (isSelected(0, 3)) {
    service.display.rect(280, 200, 80, 80, { fillColor: "black" })
    service.display.rect(288, 208, 64, 64, { fillColor: "white" })
  }
  else {
    service.display.rect(288, 208, 64, 64, { fillColor: "gray15" })
  }
  if (isSelected(0, 4)) {
    service.display.rect(360, 200, 80, 80, { fillColor: "black" })
    service.display.rect(368, 208, 64, 64, { fillColor: "white" })
  }
  else {
    service.display.rect(368, 208, 64, 64, { fillColor: "gray15" })
  }
}

