screen("grid") {
  service.display.clear("white")
  service.display.text("Grid Cursor", { x: 24, y: 28, fontHeight: 28, textColor: "gray15" })
  service.display.text("X:", { x: 300, y: 28, fontHeight: 28, textColor: "gray15" })
  service.display.text(state.cursorCol, { x: 350, y: 28, fontHeight: 28, textColor: "gray15" })
  service.display.text("Y:", { x: 390, y: 28, fontHeight: 28, textColor: "gray15" })
  service.display.text(state.cursorRow, { x: 440, y: 28, fontHeight: 28, textColor: "gray15" })
  drawRow0()
  drawRow1()
  drawRow2()
  drawRow3()
  drawRow4()
  service.display.refreshMode("fast1bpp")
  debug.print("cursor", state.cursorRow, state.cursorCol)
}
